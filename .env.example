# AI provider: openrouter | groq | openai | custom
AI_PROVIDER=openrouter
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
AI_BASE_URL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
CUSTOM_API_KEY=

# Google Programmable Search / Custom Search JSON API (server-side only)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

DATABASE_URL="postgresql://user:password@localhost:5432/munyarwanda_ai?schema=public"
NEXTAUTH_SECRET=replace-with-strong-random-32-chars-min
NEXTAUTH_URL=http://localhost:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

